# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# API access is configured as a JSON array of 64-character bearer tokens.
# Generate API tokens with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure separate requester and approver identities for two-person review.
# Never commit real tokens or encryption keys.
# SENTINEL_API_TOKENS='[{"token":"<64-hex-admin-token>","subject":"admin","role":"Administrator"},{"token":"<64-hex-approver-token>","subject":"approver","role":"Approver"}]'

# Required in production to decrypt pending approvals after a restart.
# Generate a persistent key with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SENTINEL_APPROVAL_ENCRYPTION_KEY="<64-hex-character-secret>"

# Optional path for the JSON database (default: data/sentinel-db.json).
# SENTINEL_DB_FILE="data/sentinel-db.json"

# Production live MCP proxy hosts (host[:port]) are allowlisted exactly; HTTPS is mandatory.
# Add only trusted MCP hostnames and enforce outbound egress restrictions at the network layer.
# SENTINEL_MCP_ALLOWED_HOSTS="mcp.internal.example.com,tools.example.com"

# Optional server-to-bearer-token map for authenticated upstream MCP endpoints.
# Store this only in a deployment secret manager. Values are never returned by the API.
# SENTINEL_MCP_SERVER_TOKENS='{"<server-id>":"<upstream-bearer-token>"}'

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required for runtime persistence. Use a replica set or sharded cluster because
# related approval and incident writes use MongoDB transactions.
MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0"
MONGODB_DB_NAME="sentinel_mcp"
